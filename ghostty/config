# Shell — launch zellij via zsh login shell
command = /bin/zsh -l -c zellij

# Font
font-family = JetBrainsMono Nerd Font
font-style = Regular
font-style-bold = Bold
font-style-italic = Italic
font-style-bold-italic = Bold Italic
font-size = 14

# Terminal
term = xterm-256color

# macOS: Option key acts as Alt
macos-option-as-alt = true

# Theme — auto-switch based on macOS light/dark appearance
theme = light:TokyoNight Day,dark:TokyoNight Storm

# Disable Ghostty tabs/splits — use zellij instead
keybind = super+t=unbind
keybind = super+n=unbind
keybind = super+d=unbind
keybind = super+shift+d=unbind
keybind = super+w=unbind
keybind = ctrl+shift+t=unbind
keybind = ctrl+shift+n=unbind

# Window
window-decoration = true
window-padding-x = 2
window-padding-y = 2

# Shift+Enter binding (matching alacritty config)
keybind = shift+enter=text:\x1b\x0d
