{
    "global": { "show_in_menu_bar": false },
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Alt+G → 打开/切到 ChatGPT",
                        "enabled": false,
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "g",
                                    "modifiers": { "mandatory": ["option"] }
                                },
                                "to": [{ "shell_command": "open -na 'ChatGPT' " }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Map Command+Shift+Control+R to execute 'aerospace enable toggle'",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "r",
                                    "modifiers": { "mandatory": ["left_command", "left_shift", "control"] }
                                },
                                "to": [{ "shell_command": "/opt/homebrew/bin/aerospace enable toggle" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Use command+control+shift+return to open a new Visual Studio Code instance",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "return_or_enter",
                                    "modifiers": { "mandatory": ["left_option", "left_control", "left_shift"] }
                                },
                                "to": [{ "shell_command": "/opt/homebrew/bin/code --new-window" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Press twice caps_lock to activate caps_lock & otherwise held_down and use as CTRL",
                        "enabled": false,
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "name": "caps_lock pressed",
                                        "type": "variable_if",
                                        "value": 1
                                    }
                                ],
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "key_code": "left_control" }],
                                "type": "basic"
                            },
                            {
                                "description": "Change caps_lock to command+control+option+shift.",
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": { "mandatory": ["left_command"] }
                                },
                                "to": [
                                    {
                                        "key_code": "left_control",
                                        "modifiers": ["left_command"]
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "parameters": { "basic.to_if_held_down_threshold_milliseconds": 0 },
                                "to": [
                                    {
                                        "set_variable": {
                                            "name": "caps_lock pressed",
                                            "value": 1
                                        }
                                    }
                                ],
                                "to_delayed_action": {
                                    "to_if_canceled": [
                                        {
                                            "set_variable": {
                                                "name": "caps_lock pressed",
                                                "value": 0
                                            }
                                        }
                                    ],
                                    "to_if_invoked": [
                                        {
                                            "set_variable": {
                                                "name": "caps_lock pressed",
                                                "value": 0
                                            }
                                        }
                                    ]
                                },
                                "to_if_held_down": [{ "key_code": "left_command" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Remap Command + Return for Alacritty with/without shift",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "return_or_enter",
                                    "modifiers": {
                                        "mandatory": ["option", "shift"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [{ "shell_command": "open -na Alacritty --args --config-file ~/.config/alacritty/arch.toml" }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "return_or_enter",
                                    "modifiers": {
                                        "mandatory": ["option"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [{ "shell_command": "open -na Alacritty --args --config-file ~/.config/alacritty/alacritty.toml" }],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
            "devices": [
                {
                    "identifiers": {
                        "is_keyboard": true,
                        "is_pointing_device": true,
                        "product_id": 272,
                        "vendor_id": 1452
                    },
                    "ignore": false
                },
                {
                    "identifiers": {
                        "is_keyboard": true,
                        "product_id": 394,
                        "vendor_id": 1241
                    },
                    "simple_modifications": [
                        {
                            "from": { "key_code": "left_command" },
                            "to": [{ "key_code": "left_option" }]
                        },
                        {
                            "from": { "key_code": "left_option" },
                            "to": [{ "key_code": "left_command" }]
                        }
                    ]
                }
            ],
            "fn_function_keys": [
                {
                    "from": { "key_code": "f5" },
                    "to": [{ "apple_vendor_top_case_key_code": "illumination_down" }]
                },
                {
                    "from": { "key_code": "f6" },
                    "to": [{ "apple_vendor_top_case_key_code": "illumination_up" }]
                }
            ],
            "name": "Default profile",
            "selected": true,
            "simple_modifications": [
                {
                    "from": { "key_code": "caps_lock" },
                    "to": [{ "key_code": "left_control" }]
                }
            ],
            "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" }
        }
    ]
}